{
  "private": true,
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "release": "bun run build && bun run check.package && lerna version",
    "check.package": "publint packages/uql-orm && attw --pack --profile esm-only packages/uql-orm",
    "release.patch": "bun run release patch && git push --follow-tags",
    "release.minor": "bun run release minor && git push --follow-tags",
    "release.major": "bun run release major && git push --follow-tags",
    "publish.orm": "cd packages/uql-orm && bun publish",
    "publish.codemod": "cd packages/uql-codemod && bun publish",
    "check": "bun run lint && bun run ts && bun run test && bun run build && bun run check.package",
    "ts": "tsc --noEmit",
    "build": "bun run --filter '*' build",
    "lint": "biome check .",
    "lint.fix": "biome check . --fix",
    "test": "bun run test:vitest && bun run test:bun",
    "test:vitest": "vitest run --coverage",
    "test:bun": "bun test --timeout 10000 --coverage-dir=coverage/bun ./packages/uql-orm/src/bunSql/ ./packages/uql-orm/src/sqlite/sqliteQuerier.bun.test.ts",
    "test.watch": "vitest",
    "test.focus": "vitest run -t 'shouldSetJsonBooleanField'"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        500
      ],
      "subject-case": [
        0
      ],
      "subject-full-stop": [
        0
      ]
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "^1.3.14",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "lerna": "^10.0.0",
    "lint-staged": "^17.3.0",
    "mongodb-memory-server": "11.2.0",
    "publint": "^0.3.23",
    "rimraf": "6.1.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,md}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  }
}
