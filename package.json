{
  "private": true,
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "release": "bun run check && lerna version",
    "check.package": "publint packages/uql-orm && attw --pack --profile esm-only packages/uql-orm",
    "release.patch": "bun run release patch && git push --follow-tags && bun run release.github",
    "release.minor": "bun run release minor && git push --follow-tags && bun run release.github",
    "release.major": "bun run release major && git push --follow-tags && bun run release.github",
    "release.github": "bun scripts/github-release.ts",
    "publish.orm": "cd packages/uql-orm && bun publish",
    "publish.codemod": "cd packages/uql-codemod && bun publish",
    "check": "bun run lint && bun run ts && bun run test && bun run build && bun run check.package",
    "ts": "tsc --noEmit",
    "ts.perf": "bun scripts/type-perf.ts",
    "build": "bun run --filter '*' build",
    "lint": "oxlint && oxfmt --check",
    "lint.fix": "oxlint --fix && oxfmt",
    "test": "bun run test:vitest && bun run test:bun",
    "test:vitest": "vitest run --coverage",
    "test:bun": "bun test --timeout 10000 --coverage-dir=coverage/bun ./packages/uql-orm/src/bunSql/ ./packages/uql-orm/src/sqlite/sqliteQuerier.bun.test.ts",
    "test.watch": "vitest",
    "test.focus": "vitest run -t 'shouldSetJsonBooleanField'"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        500
      ],
      "subject-case": [
        0
      ],
      "subject-full-stop": [
        0
      ]
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "^1.4.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "lerna": "^10.0.1",
    "mongodb-memory-server": "11.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "publint": "^0.3.24",
    "rimraf": "6.1.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
