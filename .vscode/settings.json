{
  // Oxfmt is the default formatter for every language it parses, so no per-language entry is needed:
  // one would only be here to name a different formatter, and nothing in this repo uses one.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "js.preferences.quoteStyle": "single",
  "ts.preferences.quoteStyle": "single",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "terminal.integrated.env.osx": {
    "CLAUDE_CONFIG_DIR": "${env:HOME}/.claude-personal"
  }
}
