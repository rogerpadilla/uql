{
  "name": "uql-example-cloudflare-d1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:apply": "wrangler d1 migrations apply DB --local",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "smoke": "node ../smoke.ts --schema 'wrangler d1 migrations apply DB --local' --drift 'uql-migrate sync --dry-run' --serve 'wrangler dev --port 3104' --url http://localhost:3104/todos"
  },
  "dependencies": {
    "uql-orm": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.146.0"
  }
}
