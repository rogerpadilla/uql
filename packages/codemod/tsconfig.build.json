{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "inlineSourceMap": false,
    "inlineSources": false,
    "declarationMap": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*-spec.ts",
    "**/*.test.ts",
    "**/*-test.ts",
    "**/test",
    "**/test-helpers.ts"
  ]
}
