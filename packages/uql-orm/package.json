{
  "name": "uql-orm",
  "homepage": "https://uql-orm.dev",
  "description": "JSON-native TypeScript ORM for Node.js, Bun and Deno. Supports PostgreSQL, PGlite, MySQL, MariaDB, SQLite, CockroachDB, Turso, Neon, Cloudflare D1 and MongoDB. Queries are plain JSON, typed to the leaf.",
  "license": "MIT",
  "version": "0.31.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/context/context.js": "./dist/context/context.browser.js"
  },
  "bin": {
    "uql-migrate": "./dist/migrate/bin.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./dialect": "./dist/dialect/index.js",
    "./entity": "./dist/entity/index.js",
    "./querier": "./dist/querier/index.js",
    "./type": "./dist/type/index.js",
    "./type/migratorDialect": "./dist/type/migratorDialect.js",
    "./util": "./dist/util/index.js",
    "./namingStrategy": "./dist/namingStrategy/index.js",
    "./migrate": "./dist/migrate/index.js",
    "./options": "./dist/options.js",
    "./mysql": "./dist/mysql/index.js",
    "./postgres": "./dist/postgres/index.js",
    "./postgres/wireCapabilities": "./dist/postgres/postgresWireDriverCapabilities.js",
    "./cockroachdb": "./dist/cockroachdb/index.js",
    "./maria": "./dist/maria/index.js",
    "./sqlite": "./dist/sqlite/index.js",
    "./mongo": "./dist/mongo/index.js",
    "./http": "./dist/http/index.js",
    "./express": "./dist/express/index.js",
    "./nestjs": "./dist/nestjs/index.js",
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/uql-browser.min.js"
    },
    "./libsql": "./dist/libsql/index.js",
    "./turso": "./dist/turso/index.js",
    "./turso/local": "./dist/turso/local.js",
    "./neon": "./dist/neon/index.js",
    "./pglite": "./dist/pglite/index.js",
    "./d1": "./dist/d1/index.js",
    "./bunSql": "./dist/bunSql/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepack": "bun run verify-dist.ts && cp ../../README.md .",
    "postpack": "rm README.md && npm pkg delete gitHead",
    "compile.browser": "bun build src/browser/index.ts --minify --sourcemap=linked --format=esm --target=browser --outdir=dist/browser --entry-naming 'uql-browser.min.[ext]'",
    "build": "bun run clean && tsc -b tsconfig.build.json && bun run compile.browser && bun run verify-dist.ts",
    "start": "tsc --watch",
    "clean": "rimraf dist .tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5.0",
    "@libsql/client": ">=0.6.0",
    "@neondatabase/serverless": ">=0.9.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@tursodatabase/database": ">=0.7.0",
    "@tursodatabase/serverless": ">=1.0.0",
    "better-sqlite3": ">=9.0.0",
    "express": ">=5.0.0",
    "mariadb": ">=3.0.0",
    "mongodb": ">=6.0.0",
    "mysql2": ">=3.0.0",
    "pg": ">=8.0.0",
    "pg-query-stream": ">=4.0.0",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "@neondatabase/serverless": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@tursodatabase/database": {
      "optional": true
    },
    "@tursodatabase/serverless": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "mariadb": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-query-stream": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.7",
    "@electric-sql/pglite-pgvector": "0.0.8",
    "@libsql/client": "^0.17.4",
    "@neondatabase/serverless": "^1.1.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "@tursodatabase/database": "^0.7.2",
    "@tursodatabase/serverless": "^1.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "mariadb": "^3.5.3",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.4",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.0",
    "rxjs": "^7.8.2",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.21.3"
  },
  "author": "Roger Padilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerpadilla/uql.git",
    "directory": "packages/uql-orm"
  },
  "bugs": {
    "url": "https://github.com/rogerpadilla/uql/issues"
  },
  "keywords": [
    "orm",
    "uql",
