{
  "name": "uql-orm",
  "homepage": "https://uql-orm.dev",
  "description": "JSON-native TypeScript ORM for Bun, Browsers, Edge, Node, Workers. Supports PostgreSQL, PGlite, MySQL, MariaDB, SQLite, CockroachDB, SQL Server, Turso, Neon, Cloudflare D1 and MongoDB. Queries are plain JSON, typed to the leaf.",
  "license": "MIT",
  "version": "0.100.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/context/context.js": "./dist/context/context.browser.js"
  },
  "bin": {
    "uql-migrate": "./dist/migrate/bin.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./migrate": "./dist/migrate/index.js",
    "./mysql": "./dist/mysql/index.js",
    "./postgres": "./dist/postgres/index.js",
    "./cockroachdb": "./dist/cockroachdb/index.js",
    "./mariadb": "./dist/mariadb/index.js",
    "./sqlite": "./dist/sqlite/index.js",
    "./mongodb": "./dist/mongodb/index.js",
    "./http": "./dist/http/index.js",
    "./express": "./dist/express/index.js",
    "./nestjs": "./dist/nestjs/index.js",
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/uql-browser.min.js"
    },
    "./libsql": "./dist/libsql/index.js",
    "./turso": "./dist/turso/index.js",
    "./turso/local": "./dist/turso/local.js",
    "./neon": "./dist/neon/index.js",
    "./pglite": "./dist/pglite/index.js",
    "./d1": "./dist/d1/index.js",
    "./bun-sql": "./dist/bunSql/index.js",
    "./package.json": "./package.json",
    "./mssql": "./dist/mssql/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "prepack": "bun run build && cp ../../README.md . && cp -R ../../skills .",
    "postpack": "rm -r README.md skills && npm pkg delete gitHead",
    "compile.browser": "bun build src/browser/index.ts --minify --sourcemap=linked --format=esm --target=browser --outdir=dist/browser --entry-naming 'uql-browser.min.[ext]'",
    "build": "bun run clean && tsc -b tsconfig.build.json && bun run compile.browser && bun run verify-dist.ts",
    "start": "tsc --watch",
    "clean": "rimraf dist .tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5.0 <0.6",
    "@libsql/client": ">=0.6.0 <0.19",
    "@neondatabase/serverless": ">=0.9.0 <2",
    "@nestjs/common": ">=10.0.0 <13",
    "@nestjs/core": ">=10.0.0 <13",
    "@tursodatabase/database": ">=0.8.2 <0.9",
    "@tursodatabase/serverless": ">=1.4.1 <2",
    "better-sqlite3": ">=9.0.0 <14",
    "express": ">=5.0.0 <6",
    "mariadb": ">=3.0.0 <4",
    "mongodb": ">=6.0.0 <8",
    "mssql": ">=11.0.0 <13",
    "mysql2": ">=3.0.0 <4",
    "pg": ">=8.0.0 <9",
    "pg-query-stream": ">=4.0.0 <5",
    "rxjs": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "@neondatabase/serverless": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@tursodatabase/database": {
      "optional": true
    },
    "@tursodatabase/serverless": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "mariadb": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-query-stream": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "mssql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@libsql/client": "^0.18.0",
    "@neondatabase/serverless": "^1.2.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/testing": "^12.1.2",
    "@tursodatabase/database": "^0.8.2",
    "@tursodatabase/serverless": "^1.4.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "mariadb": "^3.5.4",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "pg-query-stream": "^4.17.1",
    "rxjs": "^7.8.2",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.22.0"
  },
  "author": "Roger Padilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerpadilla/uql.git",
    "directory": "packages/orm"
  },
  "bugs": {
