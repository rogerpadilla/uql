{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "types": ["@types/bun"],
    // Deliberately not `esnext`: it is the one target where TypeScript emits decorator syntax
    // untransformed, which Node and every browser reject with a SyntaxError. Every dated target
    // downlevels it. Also the floor for `uql-codemod`, which builds with the TypeScript it depends on.
    "target": "es2025",
    "moduleDetection": "force",

    "strict": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "incremental": true,
    "allowUnreachableCode": false,

    "noFallthroughCasesInSwitch": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "declarationMap": true,

    // inlined, not imported: keeps `tslib` out of the published package's dependencies
    "importHelpers": false,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "paths": {
      "uql-orm": ["./packages/uql-orm/src/index.ts"],
      "uql-orm/*": ["./packages/uql-orm/src/*"]
    }
  },
  "exclude": ["node_modules", "data", "dist", "coverage", "**/*/dist"]
}
